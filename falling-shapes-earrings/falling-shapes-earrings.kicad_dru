(version 1)
(rule "Minimum clearance PWR"
	(constraint clearance (min 0.3mm))
	(condition "A.NetName == '3.3V' || A.NetName == '/COIN_PWR'")
)
(rule "Copper to edge clearance"
	(constraint edge_clearance (min 0.5mm))
)
(rule "Minimum thermal relief spoke count 1"
	(constraint min_resolved_spokes 2)
)
(rule "Minimum soldermask sliver"
	(constraint solder_mask_sliver (min 0.05mm))
)
(rule "Soldermask expansion"
	(constraint solder_mask_expansion (min 0.1mm))
)
(rule "Copper to hole clearance"
	(constraint hole_clearance (min 0.2mm))
)
(rule "Minimum connection width"
	(constraint connection_width (min 0.15mm))
)
(rule "Minimum annular width"
	(constraint annular_width (min 0.2mm))
)
(rule "Hole to hole distance"
	(constraint hole_to_hole (min 0.45mm))
)
